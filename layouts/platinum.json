{
  "id": "root",
  "type": "column",
  "theme": "platinum",
  "font": "Monaco",
  "font_size": 14,
  "ui_font": "Geneva",
  "terminal_menu": "platinum-menu",
  "titlebar": "none",
  "traffic_lights": [14, 7],
  "children": [
    {
      "id": "titlebar",
      "type": "block",
      "size": { "px": 28 },
      "window_drag": true,
      "content": { "mod": "platinum-bar" }
    },
    {
      "id": "body",
      "type": "row",
      "divider": { "width": 1, "color": "border" },
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "size": { "px": 240 },
          "min": 40,
          "max": 480,
          "background": "surface",
          "divider": { "width": 1, "color": "border" },
          "children": [
            { "id": "spaces", "type": "block", "content": { "mod": "platinum-spaces" } },
            { "id": "agents", "type": "block", "content": { "mod": "platinum-agents" } }
          ]
        },
        {
          "id": "work",
          "type": "column",
          "background": "canvas",
          "children": [
            { "id": "tabs", "type": "block", "size": { "px": 40 }, "content": { "mod": "platinum-tabs" } },
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 0,
                  "background": "surface",
                  "border": { "width": 1, "color": "#000000" },
                  "focus": { "width": 1, "color": "#000000" },
                  "header": {
                    "content": { "mod": "platinum-pane" },
                    "height": 26,
                    "position": "top",
                    "reveal": "always"
                  },
                  "lone": true
                }
              }
            }
          ]
        },
        {
          "id": "panel",
          "type": "column",
          "size": { "px": 320 },
          "min": 200,
          "max": 640,
          "hidden": true,
          "background": "surface",
          "children": [
            {
              "id": "panel-body",
              "type": "stack",
              "active": "files",
              "children": [
                { "id": "files", "type": "block", "content": { "mod": "platinum-files" } },
                { "id": "changes", "type": "block", "content": { "mod": "platinum-changes" } },
                { "id": "files-extended", "type": "block", "content": { "mod": "cria-files-extended" } }
              ]
            }
          ]
        }
      ]
    },
    { "id": "footer", "type": "block", "size": { "px": 26 }, "content": { "mod": "platinum-grip" } }
  ]
}
